# Chainlink Node Secrets Configuration
# Copy this file to secrets.toml and fill in your values:
#   cp secrets.toml.example secrets.toml
#
# NEVER commit secrets.toml to version control!

[Password]
# Keystore password for the Chainlink node wallet
# This password protects the node's Ethereum private key
Keystore = 'your-secure-keystore-password'

[Database]
# PostgreSQL connection URL for the Chainlink database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# Use 'cl-postgres' as the host when running with docker-compose
URL = 'postgresql://postgres:YOUR_CL_POSTGRES_PASSWORD@cl-postgres:5432/postgres?sslmode=disable'
