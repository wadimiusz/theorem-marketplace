# =============================================================================
# Theorem Marketplace - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Databases
# -----------------------------------------------------------------------------

# Password for the Chainlink PostgreSQL database
CL_POSTGRES_PASSWORD=your-secure-chainlink-db-password-here

# Password for the Theorem Marketplace PostgreSQL database
THEOREM_POSTGRES_PASSWORD=your-secure-theorem-db-password-here

# -----------------------------------------------------------------------------
# Ethereum / Web3
# -----------------------------------------------------------------------------

# Deployed TheoremMarketplace smart contract address
CONTRACT_ADDRESS=0x95F6Adaa8bC4848D203bE0e5FAC2F2A2bAF29bA2

# Ethereum JSON-RPC provider URL (Infura, Alchemy, or other)
# Example for Sepolia testnet:
HTTP_PROVIDER=https://sepolia.infura.io/v3/your-infura-project-id

# Block number to start syncing bounties from (0 = genesis, or use deployment block)
SYNC_FROM_BLOCK=0

# -----------------------------------------------------------------------------
# AWS SES (Email)
# -----------------------------------------------------------------------------

# Email address to receive contact form submissions
ADMIN_EMAIL=admin@example.com

# Verified sender email in AWS SES
SENDER_EMAIL=noreply@your-domain.com

# AWS region where SES is configured
AWS_REGION=eu-north-1

# AWS credentials for SES
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# -----------------------------------------------------------------------------
# Chainlink Node
# -----------------------------------------------------------------------------
# The Chainlink node requires additional configuration in:
#   - ./chainlink/config.toml  (node settings, EVM chain config)
#   - ./chainlink/secrets.toml (keystore password, database URL)
#
# For Secret Manager setup, also store:
#   - theorem-chainlink-keystore-password
#   - theorem-infura-project-id (same project ID as HTTP_PROVIDER above)
#
# See ./chainlink/README.md for setup instructions.
